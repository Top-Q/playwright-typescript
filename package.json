{
  "name": "playwright-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "catalog": "tsx scripts/build-pom-catalog.ts",
    "catalog:check": "tsx scripts/build-pom-catalog.ts --check",
    "catalog:report": "tsx scripts/build-pom-catalog.ts --report",
    "dump-dom": "npx tsx scripts/dump-dom.ts",
    "dump-dom:help": "npx tsx scripts/dump-dom.ts --help",
    "dump-dom:dom": "npx tsx scripts/dump-dom.ts --dom",
    "dump-dom:aria": "npx tsx scripts/dump-dom.ts --aria",
    "gate:lint": "eslint .",
    "gate:types": "tsc --noEmit",
    "gate:catalog": "tsx scripts/build-pom-catalog.ts --check",
    "gate:stubs": "tsx scripts/pipeline/check-stubs.ts",
    "gate:all": "npm run gate:catalog && npm run gate:types && npm run gate:lint && npm run gate:stubs",
    "pipeline:init": "tsx scripts/pipeline/run-init.ts",
    "pipeline:report": "tsx scripts/pipeline/run-report.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Top-Q/playwright-typescript.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Top-Q/playwright-typescript/issues"
  },
  "homepage": "https://github.com/Top-Q/playwright-typescript#readme",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.56",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.2.2",
    "globals": "^16.3.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
