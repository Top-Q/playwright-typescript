{
  "name": "playwright-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "catalog": "tsx scripts/build-pom-catalog.ts",
    "catalog:check": "tsx scripts/build-pom-catalog.ts --check",
    "catalog:report": "tsx scripts/build-pom-catalog.ts --report",
    "gate:lint": "eslint .",
    "gate:types": "tsc --noEmit",
    "gate:catalog": "tsx scripts/build-pom-catalog.ts --check",
    "gate:gaps": "tsx .claude/skills/gen-test/scripts/check-gaps.ts",
    "gate:all": "npm run gate:catalog && npm run gate:types && npm run gate:lint && npm run gate:gaps",
    "pipeline:preflight": "tsx .claude/skills/gen-test/scripts/preflight.ts",
    "pipeline:init": "tsx .claude/skills/gen-test/scripts/run-init.ts",
    "pipeline:set": "tsx .claude/skills/gen-test/scripts/set-field.ts",
    "pipeline:stage": "tsx .claude/skills/gen-test/scripts/stage.ts",
    "pipeline:test-run": "tsx .claude/skills/gen-test/scripts/test-run.ts",
    "pipeline:cleanup": "tsx .claude/skills/gen-test/scripts/cleanup.ts",
    "pipeline:report": "tsx .claude/skills/gen-test/scripts/run-report.ts",
    "pipeline:audit": "tsx .claude/skills/gen-test/scripts/audit-run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Top-Q/playwright-typescript.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Top-Q/playwright-typescript/issues"
  },
  "homepage": "https://github.com/Top-Q/playwright-typescript#readme",
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.10",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-playwright": "^2.2.2",
    "globals": "^16.3.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
