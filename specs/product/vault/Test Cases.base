filters:
  and:
    - file.hasTag("kind/test-case")
    - '!file.inFolder("_templates")'
views:
  - type: table
    name: All test cases
    order:
      - file.name
      - requirement
      - type
      - title
      - actors
      - approved
  - type: table
    name: Not automated yet
    filters:
      and:
        - approved == true
        - file.backlinks.filter(value.asFile().hasTag("kind/automated-test")).isEmpty()
    order:
      - file.name
      - requirement
      - title
