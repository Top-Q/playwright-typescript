filters:
  and:
    - '!file.inFolder("_templates")'
views:
  - type: table
    name: Awaiting approval
    filters:
      and:
        - file.hasTag("kind/test-case")
        - approved != true
    groupBy:
      property: requirement
      direction: ASC
    order:
      - file.name
      - approved
      - rejected
      - type
      - title
      - actors
    columnSize:
      file.name: 211
  - type: table
    name: Open questions
    filters:
      and:
        - file.hasTag("kind/clarification")
        - status == "open"
    order:
      - file.name
      - title
      - blocks
      - sources
  - type: table
    name: Test cases with no actor
    filters:
      and:
        - file.hasTag("kind/test-case")
        - actors.length == 0
    order:
      - file.name
      - requirement
      - title
    columnSize:
      file.name: 211
      note.requirement: 308
  - type: table
    name: Not automated yet
    filters:
      and:
        - file.hasTag("kind/test-case")
        - file.backlinks.filter(value.asFile().hasTag("kind/automated-test")).isEmpty()
        - approved == true
    order:
      - file.name
      - requirement
      - title
    columnSize:
      file.name: 211
  - type: table
    name: Stale tests
    filters:
      and:
        - file.hasTag("kind/automated-test")
        - stale.length > 0
    order:
      - file.name
      - stale
      - covers
      - file
  - type: table
    name: Tests covering no test case
    filters:
      and:
        - file.hasTag("kind/automated-test")
        - covers.length == 0
    order:
      - file.name
      - mode
      - file
